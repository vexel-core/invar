{
  "name": "invar",
  "version": "0.1.0",
  "description": "The Invariant-Guarded Transactional Kernel for AI Coding Agents",
  "type": "module",
  "bin": {
    "invar": "./bin/invar.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vexel-core/invar.git"
  },
  "keywords": [
    "ai",
    "agents",
    "coding-agent",
    "invariants",
    "verification",
    "git",
    "transactions",
    "mcp",
    "claude-code",
    "cursor"
  ],
  "author": "vexel-core",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "glob": "^11.0.1",
    "minimatch": "^11.0.2",
    "ora": "^8.2.0",
    "smol-toml": "^1.3.1",
    "typescript": "^5.8.2",
    "web-tree-sitter": "^0.24.7"
  },
  "devDependencies": {
    "@types/minimatch": "^6.0.0",
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "vitest": "^3.0.7"
  }
}
